# Copia este archivo a .env y rellena los valores.
# No pongas secretos reales. .env no se versiona.

# --- Obligatorias en local ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- App y Socket.IO ---
NODE_ENV="development"
PORT=3000
SOCKET_PORT=3001
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_ALLOWED_ORIGINS="http://localhost:3000"

# --- Google OAuth (opcional en local; necesario si quieres «Continuar con Google») ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Web Push (opcional). Genera claves con: pnpm generate-vapid ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:noreply@localhost"

# --- Correo (opcional; solo para recuperar contraseña) ---
EMAIL_HOST=""
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# --- Producción ---
# BLOB_READ_WRITE_TOKEN=""
# NOTIFY_SECRET=""
# NEXT_PUBLIC_IMAGE_DOMAINS=""
